#
# Copied to ~/.config/oeplatform/monitoring.env by install.sh. Fill in both
# values; never commit the filled-in file.

# Grafana's admin password (user "admin").
GF_SECURITY_ADMIN_PASSWORD=

# Password of the read-only database role oep_monitoring (see the docs page).
DATA_SOURCE_PASS=

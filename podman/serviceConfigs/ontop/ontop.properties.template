# Production ontop JDBC connection settings.
# The hostname "postgres" resolves to the postgres container on the shared
# Podman network (ContainerName=postgres in the quadlet / service name in compose).
#
# jdbc.user and jdbc.password must match POSTGRES_USER / POSTGRES_PASSWORD
# set in your .env / oep.env file. Ontop does not support environment variable
# substitution in this file, so fill in the real values directly.

jdbc.url=jdbc:postgresql://postgres:5432/oedb
jdbc.user=REPLACE_WITH_POSTGRES_USER
jdbc.password=REPLACE_WITH_POSTGRES_PASSWORD
jdbc.driver=org.postgresql.Driver
